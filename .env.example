# ==============================================
# 大模型配置：主线 MiniMax（付费），备用火山方舟
# ==============================================
# 切换模型只需改 LLM_PROVIDER 一项，URL / Key / 模型随之切换，代码零改动。
# 取值：minimax（默认，主线） | volcengine（火山方舟，备用）
# 主线调用失败时自动降级到备用提供方。
LLM_PROVIDER=minimax

# --- 主线：MiniMax ---
MINIMAX_API_KEY=<your-minimax-api-key>
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=<your-minimax-model-id>

# --- 备用：火山方舟 DeepSeek ---
DEEPSEEK_API_KEY=<your-ark-api-key>
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/v1
DEEPSEEK_MODEL=<your-endpoint-id>
DEEPSEEK_REASONING_MODEL=<your-endpoint-id>

# ==============================================
# 项目基础配置
# ==============================================
APP_NAME=resume_assessment_agent
DEBUG=true

# ==============================================
# HR后台管理员账号密码（部署时务必自定义）
# ==============================================
ADMIN_USERNAME=
ADMIN_PASSWORD=
HR_ADMIN_USERNAME=
HR_ADMIN_PASSWORD=
# 首次部署必填：不设则每次重启随机生成，导致所有 HR 被迫重新登录
SESSION_SECRET=

# ==============================================
# 公网访问地址（可选；魔搭部署无需填，代码自动从请求头推断）
# 留空让代码从 X-Forwarded-Host / Host 自动取，正确处理反代场景
# ==============================================
PUBLIC_BASE_URL=

# ==============================================
# 数据目录（可选；不填则自动判断：魔搭用 /mnt/workspace 持久化，本地用 app/data/）
# ==============================================
APP_DATA_DIR=
