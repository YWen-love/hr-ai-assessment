{
  "schema_version": "1.0",
  "job_key": "education_erjiang",
  "job_name": "初中二讲老师",

  "job_profile": {
    "industry": "K12教培",
    "responsibilities": [
      "带长期班，一期课程约六个月，单人带班量约300人",
      "前五个半月为服务期：课前为孩子做学习规划、课中辅导、课后开小灶讲题、批改作业",
      "服务期需与家长保持电话沟通反馈学情，周内有效通话200分钟/天，周末300分钟/天，每天约15通高质量通话",
      "后半个月为续费期，涉及续费或扩科推荐，无硬性业绩要求，仅与个人工资挂钩"
    ],
    "nature": ["含销售性质", "需要学科专业能力", "需要课堂表现力"],
    "work_time": ["周三至周日 13:00-23:00", "中间晚饭休息一个半小时", "续费期存在加班"],
    "rest_schedule": ["周一至周二双休"],
    "salary": [
      "服务期：每月底薪4000元加课时费2-3K",
      "续费期：每月底薪4000元加续费提成",
      "综合每月 7-15K",
      "交通补贴：每日下班后30元内打车报销",
      "住房补贴：2026届应届毕业生可申请，通常500-600元",
      "社保：正式员工入职帮交六险一金"
    ],
    "hard_gates": [
      "本科及以上，不含专升本",
      "本科2001年及以后出生，硕士研究生1999年及以后出生"
    ],
    "soft_traits": [
      "相关学科专业背景（数学、语文、英语等）",
      "良好的语言表达和课堂感染力",
      "能接受晚间和周末工作节奏",
      "有教学经验或师范类专业优先"
    ]
  },

  "dialog_check_items": [
