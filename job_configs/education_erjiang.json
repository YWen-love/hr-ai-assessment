    {
      "id": "check_shift",
      "text": "候选人是否接受周三至周日 13:00-23:00 的排班安排"
    },
    {
      "id": "check_quota",
      "text": "候选人是否接受带班量与服务期的每日通话量要求"
    },
    {
      "id": "check_salary",
      "text": "候选人是否接受课时费结构的薪资"
