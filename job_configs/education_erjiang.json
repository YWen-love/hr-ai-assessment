    "试讲", "教案", "备课", "辅导", "教学", "教师", "学科培训",
    "培训班", "教研", "批改作业"
  ],

  "score_rules": {
    "add_score": [
      {
        "id": "normal_school_and_major",
        "score": 1,
        "desc": "同时满足师范院校背景且为师范/学科类专业",
        "all_of": [
          {
            "field": "school_type.is_normal_university",
            "op": "is_true",
            "value": true
          },
          {
            "field": "major",
            "op": "contains_any",
            "value": [
              "师范", "教育学", "教育技术学", "小学教育", "中学教育", "学前教育", "特殊教育",
              "汉语言文学", "语文", "学科教学",
              "数学", "应用数学",
              "英语", "专业英语",
              "物理", "化学", "生物", "政治", "历史", "地理", "音乐", "美术", "体育"
            ]
          }
        ]
      },
      {
        "id": "degree_master",
        "field": "degree",
        "op": "contains_any",
        "value": ["硕士"],
        "score": 1,
        "desc": "学历为硕士研究生"
      },
      {
        "id": "exp_teaching",
        "field": "exp_tags",
        "op": "has_any",
        "value": [
          "教师", "助教", "代教", "代课", "带课", "课后辅导", "辅导",
          "主讲", "讲师", "学科培训", "培训", "授课", "试讲", "备课", "教学", "教研"
        ],
        "score": 1,
        "desc": "有授课 / 代课 / 助教 / 课后辅导 / 学科培训等教课经历"
      },
      {
        "id": "intent_teacher",
        "field": "resume_intention",
        "op": "contains_any",
        "value": ["教师", "授课", "讲师", "教研"],
        "score": 1,
        "desc": "求职意向为教师方向"
      }
    ],
    "minus_score": []
  },

  "level_threshold": {
    "high_min": 3,
    "mid_min": 1
  },

  "alternate_role_mapping": [
    {
      "backup_job_key": "education_learning_consultant",
