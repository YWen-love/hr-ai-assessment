{
  "job_key": "middle_school_math_teacher",
  "job_name": "初中数学教师",
  "job_profile": {
    "职责": [
      "负责初中数学日常课堂教学与作业批改，完成教学进度与质量目标",
      "组织分层辅导、月考与期末复习，帮助学生查漏补缺、提升成绩",
      "与家长沟通学情，定期输出学习建议与阶段性报告",
      "参与教研活动、集体备课与校本教材建设",
      "配合班主任和年级组做好学风建设和家校共育工作"
    ],
    "性质": [],
    "工作时间": [],
    "休息": [],
    "薪资": [],
    "硬性门槛": [
      "本科及以上学历",
      "数学相关专业",
      "持有初级及以上教师资格证",
      "中学数学教学经验2年以上",
      "熟悉初中数学教材体系与课标",
      "具备较强的板书与解题表达能力",
      "擅长启发式教学与分层教学，能带动中下游学生提升"
    ],
    "软性素质": [
      "具备良好的沟通能力",
      "具备团队协作意识",
      "工作责任心强"
    ]
  },
  "dialog_check_items": [
    "请确认最高学历是否为本科及以上，所学专业是否为数学相关专业？",
    "请出示教师资格证，并确认是否为初级及以上且证书有效。",
    "请说明中学数学教学经历的具体年限，是否累计达到2年以上？",
    "能否独立使用初中数学教材和课标备课授课，并完成分层辅导、月考复习和作业批改？",
    "是否具备启发式教学和分层教学经验，能否针对中下游学生设计提升方案？",
    "是否担任过班主任或备课组长？是否有小升初衔接、中考提分、数学竞赛辅导或教培机构与公立校双轨教学经历？"
  ],
  "exp_keywords": [
    "中学数学教学经验2年以上",
    "教师资格证",
    "初中数学教材与课标",
    "板书与解题表达",
    "启发式教学",
    "分层教学",
    "学情分析与家校沟通",
    "教研与集体备课",
    "班主任",
    "备课组长",
    "小升初衔接",
    "中考提分"
  ],
  "score_rules": {
    "add_score": [
      {
        "id": "required_education",
        "field": "degree",
        "op": "contains_any",
        "value": [
          "本科",
          "硕士研究生",
          "博士研究生"
        ],
        "score": 5,
        "desc": "最高学历达到本科及以上，符合岗位学历要求。"
      },
      {
        "id": "math_major",
        "field": "major",
        "op": "contains_any",
        "value": [
          "数学"
        ],
        "score": 5,
        "desc": "所学专业包含数学相关专业背景。"
      },
      {
        "id": "required_teaching_experience",
        "field": "exp_tags",
        "op": "has_any",
        "value": [
          "中学数学教学经验2年以上"
        ],
        "score": 8,
        "desc": "具备2年以上中学数学教学经验，满足核心任职门槛。"
      },
      {
        "id": "teacher_certificate",
        "field": "exp_tags",
        "op": "has_any",
        "value": [
          "教师资格证"
        ],
        "score": 5,
        "desc": "持有教师资格证，符合岗位准入要求。"
      },
      {
        "id": "curriculum_and_expression",
        "field": "exp_tags",
        "op": "has_all",
        "value": [
          "初中数学教材与课标",
